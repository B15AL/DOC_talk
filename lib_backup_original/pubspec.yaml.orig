name: health_ai_assistant
description: "A new Flutter project."
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: ^3.5.0   # or whatever your SDK version is

dependencies:
  flutter:
    sdk: flutter
  cupertino_icons: ^1.0.8

  # Add your packages here (correct place)
  shared_preferences: ^2.2.3
  path_provider: ^2.1.2
  permission_handler: ^11.3.0
  flutter_tts: ^4.0.2
  speech_to_text: ^6.6.0
  hive: ^2.2.3
  hive_flutter: ^1.1.0
  http: ^1.2.0
  telephony: ^0.2.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0

flutter:
  uses-material-design: true
